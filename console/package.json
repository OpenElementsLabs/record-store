{
  "name": "oes-console",
  "version": "0.1.0",
  "private": true,
  "description": "OES web console: the administrative interface for the OES management API.",
  "scripts": {
    "dev": "next dev --port 7602",
    "build": "next build",
    "start": "next start --port 7602",
    "start:e2e": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:cluster": "playwright test --config playwright.cluster.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e:install": "playwright install chromium"
  },
