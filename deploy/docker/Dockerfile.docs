# The Record Store documentation site.
#
# MkDocs renders the site at build time; the runtime image is a plain static file
# server with no Python in it. Coolify (or any container host) builds this from
# the repository root:
#
#   docker build -f deploy/docker/Dockerfile.docs \
#     --build-arg SITE_URL=https://docs.example.com/ -t record-store-docs .
FROM python:3.12-slim-bookworm@sha256:392307d22300de8b5986851a12d9176dfc0fc073e65bf6523ebd7dcbeb23564e AS builder
WORKDIR /src
# Same install as the docs workflow: every artifact is checked against the
# SHA-256 pinned in the requirements file, so a tampered package fails the build.
COPY requirements-docs.txt ./
RUN pip install --no-cache-dir --require-hashes -r requirements-docs.txt
COPY mkdocs.yml ./
COPY docs/ ./docs/
# The canonical URL written into every page. Left unset (or empty), mkdocs.yml
# falls back to the GitHub Pages address; an empty value would instead drop the
# canonical link altogether.
ARG SITE_URL
RUN if [ -z "$SITE_URL" ]; then unset SITE_URL; fi \
    && mkdocs build --strict --site-dir /site

FROM nginxinc/nginx-unprivileged:1.31.6-alpine@sha256:26b0bf6fbf07297983cb341998d79c831508787de26627dd2a112321b9c3a4af AS runtime
COPY deploy/docker/nginx-docs.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /site /usr/share/nginx/html
COPY LICENSE /usr/share/licenses/record-store/LICENSE

EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD ["wget", "-q", "--spider", "http://127.0.0.1:8080/"]
